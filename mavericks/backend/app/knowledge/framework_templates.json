{
  "version": "1.0",
  "targets": {
    "playwright": {
      "layout": ["tests", "pages", "testdata", "config"],
      "testFilePattern": "{test_name}_test.py",
      "requirements": ["pytest>=8.2,<9.0", "pytest-playwright>=0.5,<1.0", "playwright>=1.45,<2.0"],
      "pytestIni": [
        "[pytest]",
        "testpaths = tests",
        "pythonpath = .",
        "addopts = -v --browser chromium",
        "log_cli = true",
        "log_cli_level = INFO",
        "log_file = artifacts/test-run.log",
        "log_file_level = INFO",
        "junit_family = xunit2"
      ],
      "baseImports": ["import logging", "import pytest", "from playwright.sync_api import Page"],
      "fixture": "page",
      "fixtureType": "Page"
    },
    "selenium": {
      "layout": ["tests", "pages", "testdata", "config"],
      "testFilePattern": "{test_name}_test.py",
      "requirements": ["pytest>=8.2,<9.0", "selenium>=4.21,<5.0"],
      "pytestIni": [
        "[pytest]",
        "testpaths = tests",
        "pythonpath = .",
        "addopts = -v --selenium-browser chrome",
        "log_cli = true",
        "log_cli_level = INFO",
        "log_file = artifacts/test-run.log",
        "log_file_level = INFO",
        "junit_family = xunit2"
      ],
      "baseImports": ["import logging", "import pytest", "from selenium.webdriver.remote.webdriver import WebDriver"],
      "fixture": "driver",
      "fixtureType": "WebDriver"
    }
  }
}
