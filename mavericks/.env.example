# Copy to .env and adjust. Never commit .env.

# local | dev | demo | prod. Only "local" may run without API_KEY; API docs (/docs) are served only for "local".
ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:5173"]

# Shared API key (header X-API-Key) for every /api route except /api/health. Required outside ENVIRONMENT=local
# and by docker compose. Use at least 16 random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Host headers the backend answers to (DNS-rebinding protection)
ALLOWED_HOSTS=["localhost", "127.0.0.1", "[::1]"]
# URL prefixes generated tests may open. Default: only the bundled demo app. Add your application, e.g.
# ALLOWED_TARGET_URLS=["http://localhost:8001/demo/", "https://app.example.com/"]
ALLOWED_TARGET_URLS=["http://localhost:8001/demo/", "http://127.0.0.1:8001/demo/"]

# LLM provider: mock (offline, default) | azure_openai
LLM_PROVIDER=mock
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
LLM_TIMEOUT_SECONDS=30

# qTest: mock (default) | real
QTEST_MODE=mock
QTEST_BASE_URL=
QTEST_API_TOKEN=
QTEST_PROJECT_ID=

# Execution
EXECUTION_TIMEOUT_SECONDS=120
# Generated test runs (pytest + browser) at the same time; more requests get HTTP 429
MAX_CONCURRENT_EXECUTIONS=2
HEADLESS=true

# Uploads
MAX_UPLOAD_BYTES=1048576
# Maximum steps after reusable blocks are expanded
MAX_EXPANDED_STEPS=500
